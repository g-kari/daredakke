{
  "name": "daredakke",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": "12.17.0"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "check": "pnpm run typecheck && pnpm test && pnpm run build",
    "dev": "wrangler dev --local",
    "types": "wrangler types",
    "db:local": "wrangler d1 migrations apply DB --local",
    "dry-run": "pnpm run build && wrangler deploy --dry-run",
    "bundle:worker": "pnpm run build && node scripts/generate-static-assets.mjs && wrangler deploy --config wrangler.bundled.jsonc --dry-run --outdir dist-worker-bundled",
    "deploy": "node scripts/deny-unapproved-deploy.mjs",
    "test:browser": "playwright test --config tests/browser/playwright.config.mjs"
  },
  "dependencies": {
    "@animate-ui/react": "2.4.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "jose": "^6.0.0",
    "lucide-react": "^1.31.0",
    "motion": "14.9.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261029.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "miniflare": "5.20261006.1-alpha",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "wrangler": "^4.149.0"
  },
  "packageManager": "pnpm@12.17.0"
}
