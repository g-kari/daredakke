{
  "name": "daredakke",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "dev": "wrangler dev --local",
    "types": "wrangler types",
    "db:local": "wrangler d1 migrations apply DB --local",
    "dry-run": "npm run build && wrangler deploy --dry-run",
    "bundle:worker": "npm run build && node scripts/generate-static-assets.mjs && wrangler deploy --config wrangler.bundled.jsonc --dry-run --outdir dist-worker-bundled",
    "deploy": "node scripts/deny-unapproved-deploy.mjs"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "jose": "^6.0.0",
    "lucide-react": "^1.31.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261009.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "miniflare": "5.20261006.1-alpha",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "wrangler": "^4.149.0"
  }
}
