{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "automerge": false,
  "automergeType": "pr",
  "platformAutomerge": true,
  "ignoreTests": false,
  "ignoreScripts": true,
  "rebaseWhen": "behind-base-branch",
  "minimumReleaseAge": "14 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "internalChecksFilter": "strict",
  "packageRules": [
    {
      "description": "Keep every dependency review-first unless explicitly allowed below.",
      "matchPackageNames": [
        "*"
      ],
      "automerge": false
    },
    {
      "description": "Keep these updates manual until required real CI checks are enforced and verified.",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "actions/checkout",
        "actions/setup-node",
        "actions/upload-artifact"
      ],
      "matchFileNames": [
        ".github/workflows/ci.yml",
        ".github/workflows/unsaved-input-browser.yml"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pinDigest"
      ],
      "minimumReleaseAge": "14 days",
      "minimumReleaseAgeBehaviour": "timestamp-required",
      "internalChecksFilter": "strict",
      "ignoreTests": false,
      "automerge": false,
      "automergeType": "pr",
      "platformAutomerge": false,
      "ignoreScripts": true,
      "rebaseWhen": "behind-base-branch"
    },
    {
      "description": "Review pre-1.0 dependency changes explicitly.",
      "matchCurrentVersion": "/^v?0\\./",
      "automerge": false
    },
    {
      "description": "Fail closed: keep every dependency manual until required real CI checks are enforced and verified.",
      "matchPackageNames": [
        "*"
      ],
      "automerge": false
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "minimumReleaseAge": null,
    "automerge": false
  },
  "lockFileMaintenance": {
    "enabled": false,
    "automerge": false
  }
}
